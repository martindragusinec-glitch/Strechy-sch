{
  "name": "fve-strecha-nzulight",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "nzulight.schlieger.cz", "custom_domain": true },
    { "pattern": "www.nzulight.schlieger.cz", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
